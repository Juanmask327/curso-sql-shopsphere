# ============================================================
# ShopSphere — Variables de Entorno
#
# INSTRUCCIONES:
#   1. Copia este archivo:  cp .env.example .env
#      En Windows:          copy .env.example .env
#   2. Reemplaza todos los valores vacios o marcados con comentarios
#   3. Nunca commitees el archivo .env — esta en .gitignore
# ============================================================
#
# ── SECRETOS DE CI (GitHub Actions) ──────────────────────────
# Estas variables NO van en .env. Se configuran como GitHub Secrets en:
#   repo → Settings → Secrets and variables → Actions → New repository secret
# El pipeline (.github/workflows/ci.yml) las consume via ${{ secrets.NAME }}:
#   - CI_POSTGRES_PASSWORD     password de la DB efimera de tests
#   - CI_JWT_SECRET            JWT_SECRET de test (min 64 chars)
#   - CI_SESSION_COOKIE_SECRET cookie secret de test (min 32 chars)
# ============================================================


# ── Docker Compose ───────────────────────────────────────────
# Deshabilita el backend "Bake" de Docker Compose v2.35+.
# En Windows causa "invalid file request Dockerfile" al hacer docker-compose up.
COMPOSE_BAKE=false


# ── Servidor ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# trace | debug | info | warn | error
# SEGURIDAD: en producción (NODE_ENV=production) solo se permiten
# info | warn | error. Un nivel más verboso se ignora (override a "info")
# para no filtrar PII/tokens/queries en los logs.

# ── Proxy / IP del cliente ───────────────────────────────────
# Activar SOLO si la app corre detrás de un proxy de confianza
# (Railway, Vercel, Nginx) que setea X-Forwarded-For. Si está en
# false (o no seteado), se usa la IP de la conexión TCP directa.
# SEGURIDAD: con TRUST_PROXY=true sin un proxy real, un cliente puede
# falsificar X-Forwarded-For y evadir el rate limiting por IP.
TRUST_PROXY=false


# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=shopsphere
POSTGRES_USER=shopsphere_user
POSTGRES_PASSWORD=changeme_password_segura

# URL completa usada por Drizzle ORM y el backend
# En Docker el host es "db" (nombre del servicio). En local directo: "localhost"
DATABASE_URL=postgresql://shopsphere_user:changeme_password_segura@db:5432/shopsphere

# Pool de conexiones
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Puerto expuesto en tu maquina local
# (el contenedor siempre usa 5432 internamente)
POSTGRES_PORT_EXPOSED=5432


# ── Redis ─────────────────────────────────────────────────────
# En Docker el host es "redis" (nombre del servicio). En local directo: "localhost"
REDIS_URL=redis://redis:6379
REDIS_TLS=false
# En produccion con Upstash usar: rediss://user:pass@host:6380

# SEGURIDAD: en staging/produccion Redis DEBE requerir autenticacion.
# Definir REDIS_PASSWORD aqui (y arrancar Redis con --requirepass) o incluir
# las credenciales directamente en REDIS_URL. Si NODE_ENV != development y no
# hay password, el backend logueara una advertencia al arrancar.
# Dejar vacio en desarrollo local.
REDIS_PASSWORD=

# Puerto expuesto en tu maquina local
REDIS_PORT_EXPOSED=6379


# ── Auth ──────────────────────────────────────────────────────
# Genera JWT_SECRET con: openssl rand -hex 64
# O en PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
JWT_SECRET=
JWT_EXPIRY_ACCESS=15m
JWT_EXPIRY_REFRESH=7d

# Genera SESSION_COOKIE_SECRET con: openssl rand -hex 32
SESSION_COOKIE_SECRET=

# No bajar de 10 en produccion. En tests usar 4 para velocidad.
BCRYPT_ROUNDS=12


# ── Playground Engine ─────────────────────────────────────────
# El Playground corre en el navegador via sql.js (WASM).
# Estas variables controlan el Worker Pool del backend,
# usado para validacion server-side al momento de "submit".
PLAYGROUND_WORKER_POOL_SIZE=8
# Default: Math.ceil(cpus * 1.5). Ajustar segun instancia.
PLAYGROUND_QUERY_TIMEOUT_MS=5000
# Timeout maximo en ms para cada query de validacion.
PLAYGROUND_RATE_LIMIT_RPM=60
# Maximo de requests de validacion por minuto por usuario.


# ── CORS ──────────────────────────────────────────────────────
# SEGURIDAD: el default es restrictivo (fail-closed). En produccion, si no se
# configura ningun origen permitido, CORS deniega TODOS los origenes cross-site.
#
# ALLOWED_ORIGINS: lista de origenes permitidos separados por comas, sin
# trailing slash. Ejemplo: https://app.shopsphere.com,https://www.shopsphere.com
# Tiene prioridad sobre CORS_ORIGIN.
ALLOWED_ORIGINS=http://localhost:3000
# CORS_ORIGIN: fallback de un solo origen (compatibilidad). Usar ALLOWED_ORIGINS.
CORS_ORIGIN=http://localhost:3000

# ── Swagger / OpenAPI docs ────────────────────────────────────
# SEGURIDAD: OFF por default. La UI de docs (/docs) solo se monta si
# ENABLE_SWAGGER=true. Mantener en false en produccion para no exponer la API.
ENABLE_SWAGGER=false


# ── Frontend (Next.js) ────────────────────────────────────────
# Variables NEXT_PUBLIC_* son visibles en el navegador del cliente.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo disponible en el servidor de Next.js (Server Actions, API Routes)
# Secreto compartido entre frontend y backend para llamadas internas.
API_INTERNAL_SECRET=


# ── Adminer (UI de base de datos — solo desarrollo) ───────────
ADMINER_PORT=8080

# Puerto del frontend
FRONTEND_PORT=3000


# ── Google OAuth (opcional) ───────────────────────────────────
# Configurar en: https://console.cloud.google.com/apis/credentials
# Tipo de credencial: OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs: http://localhost:3001/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI de callback del backend (debe coincidir con lo configurado en Google Cloud)
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/oauth/google/callback


# ── Email (verificación y recuperación de contraseña) ─────────
#
# OPCIÓN A — Sin SMTP (desarrollo rápido):
#   Dejar SMTP_HOST vacío. Los códigos se imprimen en la consola del backend.
#
# OPCIÓN B — Mailpit (servidor de email local, recomendado para dev):
#   1. Levantar: docker-compose --profile mail up -d mailpit
#   2. Completar:
SMTP_HOST=
#      SMTP_HOST=mailpit
SMTP_PORT=1025
#   3. UI de emails en: http://localhost:8025
#   SMTP_USER y SMTP_PASS vacíos — Mailpit no los necesita.
SMTP_USER=
SMTP_PASS=
#
# OPCIÓN C — SMTP real (producción):
#   Resend:    SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_xxx
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=SG.xxx
#   Gmail:     SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=tu@gmail.com  SMTP_PASS=app-password
SMTP_FROM=ShopSphere SQL <noreply@shopsphere.app>
