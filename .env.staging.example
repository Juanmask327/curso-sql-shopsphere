# ============================================================
# ShopSphere — Variables de Entorno STAGING
#
# Este archivo documenta los valores que DIFIEREN de .env (dev).
# Para usar staging:
#   1. cp .env.staging.example .env.staging
#   2. Completa todos los valores marcados con <<COMPLETAR>>
#   3. Nunca commitees .env.staging — esta en .gitignore
#
# Comparacion con dev (.env):
#   dev  → DB local Docker, Redis local sin auth, secrets debiles OK
#   staging → Neon (PostgreSQL cloud), Upstash (Redis cloud con TLS),
#             secrets reales de 64+ chars, NODE_ENV=production
# ============================================================


# ── Servidor ─────────────────────────────────────────────────
# CAMBIO vs dev: production (activa optimizaciones, deshabilita stack traces en respuestas)
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
# CAMBIO vs dev: warn en staging (menos verbosidad que info en dev)
LOG_LEVEL=warn


# ── PostgreSQL — Neon (cloud) ────────────────────────────────
# CAMBIO vs dev: apunta a Neon, NO a localhost ni al contenedor "db"
# Obtener en: console.neon.tech → Tu proyecto → Connection String
# Formato: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://<<USUARIO_NEON>>:<<PASSWORD_NEON>>@<<HOST_NEON>>.neon.tech/<<NOMBRE_DB>>?sslmode=require

# CAMBIO vs dev: pool mas conservador para Neon free tier (max 10 conexiones)
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Las variables POSTGRES_* individuales NO se usan en staging
# (solo se usan para levantar el contenedor local en dev)
# POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD → NO DEFINIR AQUI


# ── Redis — Upstash (cloud, TLS) ─────────────────────────────
# CAMBIO vs dev: Upstash con TLS (rediss://), no redis:// sin auth
# Obtener en: console.upstash.com → Tu base de datos → REST API → Redis URL
# Formato: rediss://default:<<TOKEN>>@<<HOST>>.upstash.io:6380
REDIS_URL=rediss://default:<<TOKEN_UPSTASH>>@<<HOST_UPSTASH>>.upstash.io:6380

# CAMBIO vs dev: TLS habilitado
REDIS_TLS=true

# Password para el Redis local de staging (simulacion de auth de produccion)
# Solo relevante si usas el redis-staging del docker-compose.staging.yml
REDIS_PASSWORD=<<GENERA_CON: openssl rand -hex 16>>


# ── Auth ──────────────────────────────────────────────────────
# CAMBIO vs dev: valores reales de 64+ chars — NUNCA los mismos que dev
# Genera con: scripts/generate-secrets.sh o scripts/generate-secrets.ps1
JWT_SECRET=<<GENERA_CON: openssl rand -hex 64>>
JWT_EXPIRY_ACCESS=15m
JWT_EXPIRY_REFRESH=7d

# CAMBIO vs dev: valor real de 32+ chars
SESSION_COOKIE_SECRET=<<GENERA_CON: openssl rand -hex 32>>

# CAMBIO vs dev: 12 es el minimo aceptable en produccion
BCRYPT_ROUNDS=12

# Secreto compartido entre frontend server-side y backend (Next.js → Fastify)
API_INTERNAL_SECRET=<<GENERA_CON: openssl rand -hex 32>>


# ── Playground Engine ─────────────────────────────────────────
# CAMBIO vs dev: pool mas pequeno (staging tiene menos recursos)
PLAYGROUND_WORKER_POOL_SIZE=4
PLAYGROUND_QUERY_TIMEOUT_MS=5000
PLAYGROUND_RATE_LIMIT_RPM=60


# ── CORS ──────────────────────────────────────────────────────
# CAMBIO vs dev: dominio de staging (Vercel preview URL o dominio dedicado)
# En Vercel: Settings → Domains, o la URL generada automaticamente
# Ejemplo: https://shopsphere-staging.vercel.app
CORS_ORIGIN=https://<<SUBDOMINIO_STAGING>>.vercel.app


# ── Frontend (Next.js) ────────────────────────────────────────
# CAMBIO vs dev: URL publica del backend en Railway staging
# En Railway: Settings → Domains → tu dominio generado
# Ejemplo: https://shopsphere-backend-staging.railway.app
NEXT_PUBLIC_API_URL=https://<<NOMBRE_SERVICIO>>-staging.railway.app

# CAMBIO vs dev: URL publica del frontend en Vercel
NEXT_PUBLIC_APP_URL=https://<<SUBDOMINIO_STAGING>>.vercel.app


# ── Frontend — puerto local (solo para docker-compose.staging.yml local) ──
FRONTEND_PORT=3000


# ── Email (opcional) ──────────────────────────────────────────
# Si no tienes SMTP configurado, deja vacio — el registro funciona sin email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shopsphere.app


# ============================================================
# RESUMEN DE CAMBIOS vs .env (dev)
# ============================================================
#
# Variable                  | Dev                        | Staging
# --------------------------|----------------------------|--------------------------------
# NODE_ENV                  | development                | production
# LOG_LEVEL                 | info                       | warn
# DATABASE_URL              | postgresql://...@db:5432   | postgresql://...@neon.tech/...?sslmode=require
# REDIS_URL                 | redis://redis:6379         | rediss://...@upstash.io:6380
# REDIS_TLS                 | false                      | true
# JWT_SECRET                | (puede ser debil en dev)   | 64+ chars hex real
# SESSION_COOKIE_SECRET     | (puede ser debil en dev)   | 32+ chars hex real
# API_INTERNAL_SECRET       | (vacio OK en dev)          | 32+ chars hex real
# CORS_ORIGIN               | http://localhost:3000      | https://tu-dominio.vercel.app
# NEXT_PUBLIC_API_URL       | http://localhost:3001      | https://tu-backend.railway.app
# NEXT_PUBLIC_APP_URL       | http://localhost:3000      | https://tu-dominio.vercel.app
# POSTGRES_*                | usadas por contenedor local| NO definir (Neon las maneja)
# BCRYPT_ROUNDS             | 12 (OK)                    | 12 (igual)
# ============================================================
