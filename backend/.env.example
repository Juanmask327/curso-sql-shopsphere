# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development                         # development | test | production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info                               # trace | debug | info | warn | error

# ── Base de datos principal (PostgreSQL / Neon) ───────────────────────────────
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://user:pass@host:6380
REDIS_TLS=true

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRY_ACCESS=15m
JWT_EXPIRY_REFRESH=7d
# Generar con: openssl rand -hex 32
SESSION_COOKIE_SECRET=
BCRYPT_ROUNDS=12

# ── Playground Engine ─────────────────────────────────────────────────────────
PLAYGROUND_WORKER_POOL_SIZE=8
PLAYGROUND_QUERY_TIMEOUT_MS=5000
PLAYGROUND_RATE_LIMIT_RPM=60
PLAYGROUND_DATASET_PATH=./data/dataset.db

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Opcional: email para verificación de cuenta ──────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=noreply@shopsphere.app
